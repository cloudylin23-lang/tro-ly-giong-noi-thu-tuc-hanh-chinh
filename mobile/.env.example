# Copy thành mobile/.env khi chạy local (npx expo run:android).
# Emulator gọi server local: http://10.0.2.2:3000
# Điện thoại thật cùng wifi: http://<IP-laptop>:3000   (chỉ bản debug)
# Bản APK release: PHẢI dùng HTTPS (URL Vercel) — đặt trong eas.json
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
EXPO_PUBLIC_APP_TOKEN=
