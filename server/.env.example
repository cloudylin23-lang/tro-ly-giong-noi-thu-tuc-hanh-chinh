# Copy thành .env.local (chạy local) và khai báo y hệt trên Vercel → Settings → Environment Variables.
# Mọi biến được đọc + kiểm tra ở lib/config.ts. Thiếu/sai → `npm run dev` dừng ngay và in lỗi;
# trên Vercel → /api/health trả ok:false kèm danh sách biến lỗi.

# ---- BẮT BUỘC ----
OPENAI_API_KEY=sk-...

# ---- Tuỳ chọn ----
# Chuỗi ngẫu nhiên. App gửi kèm header x-app-token. Bỏ trống = không kiểm tra.
# LƯU Ý: token này nằm trong APK nên KHÔNG phải bí mật — chỉ hợp cho 1 bản demo.
APP_TOKEN=

# Model chính (đổi để so sánh tốc độ/chất lượng bằng `npm run samples`)
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_MODEL=gpt-4.1-mini
# Model dự phòng — dùng khi model chính lỗi tạm thời (429, timeout, 5xx) hoặc trả sai định dạng
OPENAI_STT_FALLBACK_MODEL=gpt-4o-mini-transcribe
OPENAI_FALLBACK_MODEL=gpt-4o-mini
# Chỉ đặt nếu model chính có reasoning (vd gpt-5.4-mini): none | minimal | low (không áp cho model dự phòng)
OPENAI_REASONING_EFFORT=

# Thời gian chờ mỗi lần gọi (ms, 1000–120000). Tổng chính + dự phòng phải < thời gian app chờ
# (mobile/src/lib/api.ts: turn 15s, stt 25s) và < maxDuration trong vercel.json (30s).
# Mặc định: LLM 8000 + 6000 = 14s, STT 13000 + 10000 = 23s. Tăng timeout của app thì mới tăng ở đây.
OPENAI_LLM_TIMEOUT_MS=
OPENAI_LLM_FALLBACK_TIMEOUT_MS=
OPENAI_STT_TIMEOUT_MS=
OPENAI_STT_FALLBACK_TIMEOUT_MS=
