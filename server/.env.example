# Copy thành .env.local (chạy local) và khai báo y hệt trên Vercel → Settings → Environment Variables
OPENAI_API_KEY=sk-...

# Chuỗi ngẫu nhiên. App gửi kèm header x-app-token. Bỏ trống = không kiểm tra (chỉ dùng khi dev).
APP_TOKEN=

# Model (đổi để so sánh tốc độ/chất lượng bằng `npm run samples`)
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_MODEL=gpt-4.1-mini
# Chỉ đặt nếu dùng model có reasoning (vd gpt-5.4-mini): none | minimal | low
OPENAI_REASONING_EFFORT=
